---
import { Code } from "astro:components";
import Badge from "@components/common/Badge.astro";
import type { ComponentProps } from "astro/types";
import { Icon } from "astro-icon/components";
import { componentLibraryConfig } from "@/config/componentLibraryConfig";
import { expressiveCodeConfig } from "@/config/expressiveCodeConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { ComponentLibraryItem } from "@/types/componentLibraryConfig";
import { url } from "@/utils/url-utils";

export function getStaticPaths() {
	return componentLibraryConfig.map((item) => ({
		params: { slug: item.slug },
		props: { item },
	}));
}

interface Props {
	item: ComponentLibraryItem;
}

const { item } = Astro.props;
const { component: Preview } = item;
const listUrl = url("/components/");

// 源码用 Astro 内置的 Code 组件高亮，亮暗主题与站点代码块保持一致
// 主题名在配置里是宽泛的 string，这里窄化成 Code 组件要求的主题名联合类型
type CodeThemeName = NonNullable<ComponentProps<typeof Code>["themes"]>[string];

const codeThemes: ComponentProps<typeof Code>["themes"] = {
	light: expressiveCodeConfig.lightTheme as CodeThemeName,
	dark: expressiveCodeConfig.darkTheme as CodeThemeName,
};
---

<MainGridLayout title={item.name} description={item.description}>
  <!-- 组件名称与类型 -->
  <div class="card-base px-8 py-6 mb-4">
    <a
      href={listUrl}
      class="inline-flex items-center gap-1 text-sm text-50 hover:text-(--primary) transition-colors"
    >
      <Icon name="material-symbols:arrow-back-rounded" class="text-base" />
      返回组件库
    </a>
    <div class="flex flex-wrap items-center gap-3 mt-3">
      <h1 class="text-3xl font-bold text-(--primary)">{item.name}</h1>
      <Badge>{item.type}</Badge>
    </div>
  </div>

  <!-- 组件预览 -->
  <div class="card-base flex items-center justify-center min-h-56 px-6 py-12 mb-4 bg-(--btn-regular-bg)">
    <Preview />
  </div>

  <!-- 组件介绍 -->
  <div class="card-base px-8 py-6 mb-4">
    <h2 class="flex items-center gap-2 text-xl font-bold text-90 mb-3">
      <Icon name="material-symbols:info-outline-rounded" class="text-(--primary)" />
      组件介绍
    </h2>
    <p class="text-sm leading-relaxed text-75">{item.description}</p>
  </div>

  <!-- 组件源码 -->
  <div id="source" class="card-base scroll-mt-24 px-8 py-6">
    <h2 class="flex items-center gap-2 text-xl font-bold text-90 mb-3">
      <Icon name="material-symbols:code-rounded" class="text-(--primary)" />
      组件源码
    </h2>
    <div class="code-panel border border-(--line-divider) rounded-(--radius-lg) overflow-hidden">
      <div class="flex items-center justify-between gap-2 px-4 py-2 bg-(--btn-regular-bg) border-b border-(--line-divider)">
        <span class="text-xs font-semibold text-50">astro</span>
        <button
          type="button"
          data-copy-code
          class="text-xs font-semibold text-75 transition-colors hover:text-(--primary)"
        >
          复制代码
        </button>
      </div>
      <Code code={item.source} lang="astro" themes={codeThemes} />
    </div>
  </div>
</MainGridLayout>

<script>
  const COPY_LABEL = "复制代码";
  const COPIED_LABEL = "已复制";

  // 事件委托，Swup 换页后无需重新绑定
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const button = target?.closest("button[data-copy-code]");
    if (!(button instanceof HTMLButtonElement) || !navigator.clipboard) return;

    const source = button.closest(".code-panel")?.querySelector("pre code")?.textContent;
    if (!source) return;

    navigator.clipboard.writeText(source).then(() => {
      button.textContent = COPIED_LABEL;
      window.setTimeout(() => {
        button.textContent = COPY_LABEL;
      }, 1500);
    });
  });
</script>

<style>
  /* 源码面板：代码块自身承担底色，这里只统一内边距与字体 */
  .code-panel :global(pre) {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5rem;
    font-family: var(
      --font-code,
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      "Liberation Mono",
      "Courier New",
      monospace
    );
  }

  /* 双主题高亮：亮色走内联样式，暗色切到 --shiki-dark 变量 */
  :global(html.dark) .code-panel :global(pre) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }

  :global(html.dark) .code-panel :global(pre span) {
    color: var(--shiki-dark) !important;
  }
</style>
